<?xml version="1.0" encoding="utf-8"?>

<Mod id="limespace-snowflake" version="1" xmlns="ModInfo">

    <Properties>

        <Name>Limespace Snowflake</Name>

        <Description>
            A symmetrical six-arm Snowflake map designed for balanced six-player games.
        </Description>

        <Authors>Limespace</Authors>

        <Package>Mod</Package>

        <AffectsSavedGames>1</AffectsSavedGames>

        <Version>1</Version>

    </Properties>


    <Dependencies>

        <Mod
            id="base-standard"
            title="LOC_MODULE_BASE_STANDARD_NAME"
        />

    </Dependencies>


    <References>

        <Mod
            id="core"
            title="LOC_MODULE_CORE_NAME"
        />

    </References>


    <ActionCriteria>

        <Criteria id="always">
            <AlwaysMet/>
        </Criteria>

    </ActionCriteria>


    <ActionGroups>


        <!-- ===================================================
             SHELL / MAP SELECTION
             =================================================== -->

        <ActionGroup
            id="limespace-snowflake-shell"
            scope="shell"
            criteria="always">

            <Properties>
                <LoadOrder>100</LoadOrder>
            </Properties>


            <Actions>

                <UpdateDatabase>

                    <Item>
                        config/config.xml
                    </Item>

                </UpdateDatabase>


                <UpdateText>

                    <Item>
                        text/snowflake-text.xml
                    </Item>

                </UpdateText>

            </Actions>

        </ActionGroup>


        <!-- ===================================================
             GAME / MAP GENERATOR
             =================================================== -->

        <ActionGroup
            id="limespace-snowflake-map"
            scope="game"
            criteria="always">

            <Properties>
                <LoadOrder>100</LoadOrder>
            </Properties>


            <Actions>

                <!-- Load custom gameplay map-size definition -->

                <UpdateDatabase>

                    <Item>
                        data/snowflake-map-size.xml
                    </Item>

                </UpdateDatabase>


                <!-- Load Snowflake map scripts -->

                <MapGenScripts>

                    <Item>
                        maps/map-globals.js
                    </Item>

                    <Item>
                        maps/snowflake-map-data.js
                    </Item>

                    <Item>
                        maps/snowflake-terrain.js
                    </Item>

                    <Item>
                        maps/snowflake-features.js
                    </Item>

                    <Item>
                        maps/snowflake.js
                    </Item>

                </MapGenScripts>

            </Actions>

        </ActionGroup>


    </ActionGroups>

</Mod>